@chapter 11 | quiz
@intro
<p>Смотрим на процессы и потоки глазами ядра: дерево процессов и зомби, цену переключения контекста для платформенных и виртуальных потоков, вред лишних потоков на счётной задаче и расхождение <code>Thread.State</code> с состоянием в ядре. Лабы 11.1 и 11.4 — в Docker-образе <code>cs-lab</code>. Модуль IDEA — <code>cs11</code>.</p>
@end

@lab 11.1 | fork, exec, зомби | 15 мин
@goal
<p>Создать дочерние процессы, увидеть зомби и то, как <code>wait</code> его убирает.</p>
@end
@file zombie.c
#include <stdio.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

int main(void) {
    pid_t child = fork();
    if (child == 0) {                                   // потомок
        printf("потомок: мой PID %d, родитель %d — завершаюсь с кодом 7\n", getpid(), getppid());
        exit(7);
    }
    sleep(1);                                           // потомок уже завершился, но wait ещё не вызван
    printf("родитель: потомок %d завершился, смотрим ps:\n", child);
    fflush(stdout);
    char cmd[64];
    snprintf(cmd, sizeof cmd, "ps -o pid,ppid,stat,comm -p %d", child);
    system(cmd);                                        // system = fork + exec("sh -c …") + wait

    int status;
    waitpid(child, &status, 0);
    printf("родитель: wait вернул код %d, ps снова:\n", WEXITSTATUS(status));
    fflush(stdout);
    system(cmd);
    return 0;
}
@end
@run
docker run --rm -v "${PWD}:/lab" cs-lab sh -c "gcc -o zombie zombie.c && ./zombie" ||| MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd -W):/lab" cs-lab sh -c "gcc -o zombie zombie.c && ./zombie"
@end
@predict Какое состояние покажет <code>ps</code> у потомка до <code>wait</code>? А после?
@answer
<p>До <code>wait</code> — <code>Z</code> (зомби, в столбце COMMAND — <code>[zombie] &lt;defunct&gt;</code>): процесс завершился, но запись с кодом 7 ждёт родителя. После <code>waitpid</code> родитель получил код 7, запись удалена — <code>ps</code> ничего не находит (только заголовок). Обратите внимание: <code>system()</code> сам по себе — fork, exec оболочки и wait.</p>
@end

@lab 11.2 | Цена переключения: платформенные и виртуальные потоки | 15 мин
@goal
<p>Измерить «пинг-понг» двух потоков, которые по очереди будят друг друга, — каждый ход требует уснуть и разбудить другого.</p>
@end
@file PingPong.java
import java.util.concurrent.locks.LockSupport;

public class PingPong {
    static volatile int turn;

    static long roundTripNanos(boolean virtual, int rounds) throws InterruptedException {
        Thread[] t = new Thread[2];
        Runnable a = () -> { for (int i = 0; i < rounds; i++) { while (turn != 0) LockSupport.park(); turn = 1; LockSupport.unpark(t[1]); } };
        Runnable b = () -> { for (int i = 0; i < rounds; i++) { while (turn != 1) LockSupport.park(); turn = 0; LockSupport.unpark(t[0]); } };
        t[0] = virtual ? Thread.ofVirtual().unstarted(a) : Thread.ofPlatform().unstarted(a);
        t[1] = virtual ? Thread.ofVirtual().unstarted(b) : Thread.ofPlatform().unstarted(b);
        long t0 = System.nanoTime();
        t[0].start(); t[1].start(); t[0].join(); t[1].join();
        return (System.nanoTime() - t0) / rounds;
    }

    public static void main(String[] args) throws Exception {
        for (int r = 0; r < 3; r++) {
            turn = 0;
            long p = roundTripNanos(false, 200_000);
            turn = 0;
            long v = roundTripNanos(true, 200_000);
            System.out.printf("круг A→B→A: платформенные %,6d нс | виртуальные %,6d нс%n", p, v);
        }
    }
}
@end
@predict Во сколько раз круг у виртуальных потоков дешевле?
@answer
<p>Платформенные — около 10 мкс на круг на Windows (два засыпания в ядре, два пробуждения, переключения контекста и, возможно, переход на другое ядро). Виртуальные — 1–2 мкс: «уснуть» — снять продолжение с потока-носителя, «разбудить» — поставить в очередь планировщика ForkJoinPool, всё в пользовательском режиме. Разница — примерно на порядок.</p>
@end
@run
javac PingPong.java
java PingPong
@end
@try
Запустите с <code>-Djdk.virtualThreadScheduler.parallelism=1</code>. ::: Виртуальные потоки станут ещё быстрее (сотни наносекунд): оба живут на одном носителе, и переключение — просто смена продолжения в том же потоке ОС, без межъядерной передачи данных и пробуждений.
@end

@lab 11.3 | Больше потоков — не быстрее | 15 мин
@goal
<p>Запустить одну и ту же счётную работу в пулах разного размера.</p>
@end
@file Oversub.java
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.*;

public class Oversub {
    static long work(long seed) {                       // чистый счёт, без памяти и ожиданий
        long x = seed;
        for (int i = 0; i < 20_000_000; i++) x = x * 6364136223846793005L + 1442695040888963407L;
        return x;
    }

    public static void main(String[] args) throws Exception {
        int cores = Runtime.getRuntime().availableProcessors();
        System.out.println("логических процессоров: " + cores);
        int tasks = 288;
        for (int threads : new int[] {1, cores / 2, cores, cores * 4, cores * 16}) {
            ExecutorService pool = Executors.newFixedThreadPool(threads);
            List<Future<Long>> fs = new ArrayList<>();
            long t0 = System.nanoTime();
            for (int i = 0; i < tasks; i++) { long s = i; fs.add(pool.submit(() -> work(s))); }
            long sum = 0;
            for (Future<Long> f : fs) sum += f.get();
            long ms = (System.nanoTime() - t0) / 1_000_000;
            pool.shutdown();
            System.out.printf("потоков %4d: %5d мс  (%x)%n", threads, ms, sum & 0xF);
        }
    }
}
@end
@predict Где будет минимум времени? Что произойдёт при 4× и 16× больше потоков, чем процессоров?
@answer
<p>Время падает почти пропорционально до числа <i>физических</i> ядер, дальше рост слабее (SMT-«ядра» и E-ядра делят ресурсы), минимум — около числа логических процессоров. При 4× и 16× потоков быстрее не становится, обычно чуть медленнее: потоков больше, чем процессоров, планировщик вытесняет их по кванту, растут переключения и промахи кэша. Для счётной работы пул больше <code>availableProcessors()</code> не нужен.</p>
@end
@run
javac Oversub.java
java Oversub
@end

@lab 11.4 | Thread.State против состояния в ядре | 15 мин
@goal
<p>Сравнить, что о потоках говорит Java и что говорит ядро Linux.</p>
@end
@file States.java
import java.io.IOException;
import java.io.UncheckedIOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.HashMap;
import java.util.Map;

public class States {
    static final Map<String, Long> tids = new HashMap<>();

    static String kernelState(long tid) throws IOException {      // третье поле /proc/<pid>/task/<tid>/stat
        String s = Files.readString(Path.of("/proc/self/task/" + tid + "/stat"));
        return s.substring(s.lastIndexOf(')') + 2, s.lastIndexOf(')') + 3);
    }

    static void register(String name) {
        Thread.currentThread().setName(name);
        try {
            long tid = Long.parseLong(Files.readSymbolicLink(Path.of("/proc/thread-self")).getFileName().toString());
            synchronized (tids) { tids.put(name, tid); }
        } catch (IOException e) { throw new UncheckedIOException(e); }
    }

    public static void main(String[] args) throws Exception {
        Object lock = new Object();
        Process sleeper = new ProcessBuilder("sleep", "30").start();   // канал, в который никто не пишет
        Thread[] ts = {
            new Thread(() -> { register("счёт"); long x = 0; while (true) x++; }),
            new Thread(() -> { register("sleep"); try { Thread.sleep(30_000); } catch (InterruptedException e) { } }),
            new Thread(() -> { register("монитор"); synchronized (lock) { } }),
            new Thread(() -> { register("чтение"); try { sleeper.getInputStream().read(); } catch (IOException e) { } }),
        };
        synchronized (lock) {
            for (Thread t : ts) { t.setDaemon(true); t.start(); }
            Thread.sleep(800);
            for (Thread t : ts)
                System.out.printf("%-8s Java: %-14s ядро: %s%n", t.getName(), t.getState(), kernelState(tids.get(t.getName())));
        }
        sleeper.destroy();
    }
}
@end
@run
docker run --rm -v "${PWD}:/lab" cs-lab java States.java ||| MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd -W):/lab" cs-lab java States.java
@end
@predict Какие состояния покажут Java и ядро для каждого из четырёх потоков?
@answer
<p>«счёт» — <code>RUNNABLE</code> / <code>R</code>: совпадает. «sleep» — <code>TIMED_WAITING</code> / <code>S</code>. «монитор» — <code>BLOCKED</code> / <code>S</code>: ожидание монитора в ядре — это сон на futex. «чтение» — <code>RUNNABLE</code> / <code>S</code>: Java считает поток работающим, а он спит в ядре в <code>read</code> из пустого канала. Именно поэтому «много RUNNABLE в дампе» не означает загрузки процессора.</p>
@end
